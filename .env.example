# Copy this file to `.env.local` (ignored by Git) and fill in your Supabase project details.
# `build.rs` automatically reads `.env` and `.env.local` at compile time via `option_env!`.
# Note: DATABASE_URL must be your Supabase HTTPS Project URL (https://<ref>.supabase.co), not postgresql://
DATABASE_URL=
DATABASE_ANON_KEY=
# Postgres schema name (default: public; change e.g. to `fynexo` if using per-app schema isolation)
DATABASE_SCHEMA=public
DATABASE_TABLE=extensions
